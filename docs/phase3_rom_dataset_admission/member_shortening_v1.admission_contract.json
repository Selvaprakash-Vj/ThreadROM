{
  "admission_gates": [
    {
      "gate_id": "DA01_TARGET_BINDING",
      "requirement": "Exact frozen member-shortening target contract identity and SHA match."
    },
    {
      "gate_id": "DA02_CASE_IDENTITY",
      "requirement": "case_id and case_hash are present and exactly bound to the certified source evidence."
    },
    {
      "gate_id": "DA03_EXECUTION_IDENTITY",
      "requirement": "case_run_id, accepted run_id and trial_index exactly match the governing accepted FEM evidence."
    },
    {
      "gate_id": "DA04_ENGINEERING_INPUTS",
      "requirement": "Canonical engineering inputs are fully resolved, unit-defined and free of unresolved adapter status."
    },
    {
      "gate_id": "DA05_PHYSICS_ACCEPTANCE",
      "requirement": "The governing FEM state is FINAL and full-physics accepted with all applicable hard gates passed."
    },
    {
      "gate_id": "DA06_TARGET_EXTRACTION",
      "requirement": "member_shortening_mm is deterministically extracted from the final accepted nonlinear FEM state under the frozen target-extraction contract."
    },
    {
      "gate_id": "DA07_TARGET_VALUE",
      "requirement": "The extracted target is finite and nonzero."
    },
    {
      "gate_id": "DA08_NUMERICAL_CERTIFICATION",
      "requirement": "Target-specific numerical certification passes the predeclared relative limit of 0.02."
    },
    {
      "gate_id": "DA09_PROVENANCE",
      "requirement": "Required source artifacts, certificates, extraction implementation and governing hashes are reproducible."
    },
    {
      "gate_id": "DA10_APPLICABILITY",
      "requirement": "The sample lies within the documented governed engineering applicability envelope."
    },
    {
      "gate_id": "DA11_HOLDOUT_PROTECTION",
      "requirement": "A sealed blind-holdout identity may not be inspected or admitted through the training-candidate workflow."
    },
    {
      "gate_id": "DA12_PARTITION_BOUNDARY",
      "requirement": "Dataset admission does not itself assign training, validation or independent-evaluation membership."
    }
  ],
