def historical_contract(
    wave: str,
    auth_sha: str,
    prep_sha: str,
):
    return build_governed_wave_execution_contract(
        campaign_id="TRM-DDOE-001",
        wave_token=wave,
        expected_owner_authorization_sha256=auth_sha,
        expected_preparation_index_sha256=prep_sha,
        authorized_case_count=4,
        maximum_concurrent_solver_slots=4,
        maximum_trial_index=6,
    )


w01_contract = historical_contract(
    "W01",
    W01_AUTH,
    W01_PREP,
)

w02_contract = historical_contract(
    "W02",
    W02_AUTH,
    W02_PREP,
)

w01_runner = build_governed_wave_runner(
    repository_root=ROOT,
    contract=w01_contract,
)

w02_runner = build_governed_wave_runner(
    repository_root=ROOT,
    contract=w02_contract,
)

