def require(
    condition: bool,
    message: str,
) -> None:
    if not condition:
        raise RuntimeError(
            message
        )


def sha256_file(
    path: Path,
) -> str:
    require(
        path.is_file(),
        f"Missing required artifact: {path}",
    )

    digest = hashlib.sha256()

    with path.open(
        "rb"
    ) as stream:
        for chunk in iter(
            lambda: stream.read(
                8 * 1024 * 1024
            ),
            b"",
        ):
            digest.update(
                chunk
            )

    return digest.hexdigest()


def canonical_bytes(
    payload: dict,
) -> bytes:
    return (
        json.dumps(
            payload,
            sort_keys=True,
            separators=(
                ",",
                ":",
            ),
            ensure_ascii=True,
            allow_nan=False,
        )
        + "\n"
    ).encode(
        "utf-8"
    )


def write_immutable_json(
    path: Path,
    payload: dict,
) -> str:
    encoded = canonical_bytes(
        payload
    )

    digest = hashlib.sha256(
        encoded
    ).hexdigest()

    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    if path.exists():
        existing = path.read_bytes()

        require(
            existing == encoded,
            (
                "Immutable closure artifact drift: "
                f"{path}"
            ),
        )

        return digest

    path.write_bytes(
        encoded
    )

    return digest


def contract_sha(
    contract,
) -> str:
    value = getattr(
        contract,
        "contract_sha256",
    )

    if callable(
        value
    ):
        value = value()

    return str(
        value
    )


for key, expected_sha in EXPECTED.items():
    actual_sha = sha256_file(
        PATHS[
            key
        ]
    )

    require(
        actual_sha
        == expected_sha,
        (
            f"{key} SHA drift: "
            f"expected {expected_sha}, "
            f"found {actual_sha}."
        ),
    )


