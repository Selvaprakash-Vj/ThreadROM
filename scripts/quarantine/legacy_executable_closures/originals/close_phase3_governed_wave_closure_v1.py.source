# ==============================================================================

from threadrom.factory.governed_wave_closure import (
    GovernedWaveExpectedCase,
    build_governed_wave_closure_record,
    persist_governed_wave_closure,
    recover_governed_wave_acceptance_evidence,
    recover_governed_wave_closure,
)

from threadrom.factory.governed_wave_contract import (
    build_governed_wave_execution_contract,
)

from threadrom.factory.governed_wave_runner import (
    build_governed_wave_runner,
)

from threadrom.factory.governed_wave_state_machine import (
    GovernedCaseCampaignSnapshot,
    GovernedWaveAction,
    GovernedWaveCampaignSnapshot,
    GovernedWavePhase,
    decide_governed_wave_campaign,
)


# ==============================================================================
# Replay and freeze W01 + W02 wave closure evidence
# ==============================================================================

wave_results = {}


for wave_token in (
    "W01",
    "W02",
):
    data = HISTORICAL[
        wave_token
    ]

    contract = (
        build_governed_wave_execution_contract(
            campaign_id="TRM-DDOE-001",
            wave_token=wave_token,
            expected_owner_authorization_sha256=(
                data[
                    "auth"
                ]
            ),
            expected_preparation_index_sha256=(
                data[
                    "prep"
                ]
            ),
            authorized_case_count=4,
            maximum_concurrent_solver_slots=4,
            maximum_trial_index=6,
        )
    )

    actual_contract_sha = (
        contract_sha(
            contract
        )
    )

    require(
        actual_contract_sha
        == data[
            "contract"
        ],
        (
            f"{wave_token}: execution-contract SHA drift."
        ),
    )

    runner = build_governed_wave_runner(
        repository_root=ROOT,
        contract=contract,
    )

    runner.call(
        "verify_owner_authorization"
    )

    contexts = (
        runner.build_case_contexts()
    )

    require(
        len(
            contexts
        )
        == 4,
        (
            f"{wave_token}: authorized context count drift."
        ),
    )

    expected_cases = tuple(
        GovernedWaveExpectedCase(
            case_id=context[
                "case_id"
            ],
            case_hash=context[
                "case_hash"
            ],
            case_run_id=context[
                "case_run_id"
            ],
        )
        for context in contexts
    )

    database_path = (
        concrete_repo_path(
            data[
                "database"
            ]
        )
    )

    database_before = (
        sha256_file(
            database_path
        )
    )

    require(
        database_before
        == data[
            "database_sha256"
        ],
        (
            f"{wave_token}: historical registry SHA drift "
            "before closure replay."
        ),
    )

    evidence = (
        recover_governed_wave_acceptance_evidence(
            repo_root=ROOT,
            wave_id=contract.wave_id,
            factory_database_path=(
                contract.factory_database_path
            ),
            expected_cases=expected_cases,
        )
    )

    require(
        len(
            evidence.cases
        )
        == 4,
        (
            f"{wave_token}: expected 4 accepted cases."
        ),
    )

    certificate_set = {
        case.case_id: (
            case.certificate_sha256
        )
        for case in evidence.cases
    }

    require(
        certificate_set
        == data[
            "certificates"
        ],
        (
            f"{wave_token}: governed certificate-set drift."
        ),
    )

    require(
        all(
            case.hard_gate_count
            == 13
            for case in evidence.cases
        ),
        (
            f"{wave_token}: governed hard-gate count drift."
        ),
    )

    require(
        all(
            case.accepted_increment_count
            == 20
            for case in evidence.cases
        ),
        (
            f"{wave_token}: accepted increment count drift."
        ),
    )

    require(
        all(
            case.rotational_moment_equilibrium_status
            == "not_assessed"
            for case in evidence.cases
        ),
        (
            f"{wave_token}: rotational equilibrium "
            "scope unexpectedly changed."
        ),
    )

    record = (
        build_governed_wave_closure_record(
            evidence=evidence,
            execution_contract_sha256=(
                actual_contract_sha
            ),
            owner_authorization_sha256=(
                data[
                    "auth"
                ]
            ),
            preparation_index_sha256=(
                data[
                    "prep"
                ]
            ),
        )
    )

    replay_path = (
        REPLAY_ROOT
        / (
            contract.wave_id
            + ".wave_closure.json"
        )
    )

    closure_sha = (
        persist_governed_wave_closure(
            path=replay_path,
            record=record,
        )
    )

    recovered = (
        recover_governed_wave_closure(
            path=replay_path,
            expected_wave_id=(
                contract.wave_id
            ),
            expected_evidence=evidence,
        )
    )

    require(
        recovered is not None,
        (
            f"{wave_token}: persisted closure "
            "could not be recovered."
        ),
    )

    require(
        recovered.get(
            "execution_contract_sha256"
        )
        == actual_contract_sha,
        (
            f"{wave_token}: closure contract SHA drift."
        ),
    )

    require(
        recovered.get(
            "owner_authorization_sha256"
        )
        == data[
            "auth"
        ],
        (
            f"{wave_token}: closure owner-auth SHA drift."
        ),
    )

    require(
        recovered.get(
            "preparation_index_sha256"
        )
        == data[
            "prep"
        ],
        (
            f"{wave_token}: closure preparation SHA drift."
        ),
    )

    snapshot = (
        GovernedWaveCampaignSnapshot(
            wave_id=contract.wave_id,
            authority_verified=True,
            authorized_case_count=4,
            cases=tuple(
                GovernedCaseCampaignSnapshot(
                    case_id=case.case_id,
                    full_physics_accepted=True,
                )
                for case in evidence.cases
            ),
            closure_verified=True,
        )
    )

    decision = (
        decide_governed_wave_campaign(
            snapshot
        )
    )

    require(
        decision.phase
        is GovernedWavePhase.CLOSED,
        (
            f"{wave_token}: state machine did not "
            "enter CLOSED."
        ),
    )

    require(
        decision.action
        is GovernedWaveAction.NONE,
        (
            f"{wave_token}: closed wave still "
            "requests an action."
        ),
    )

    database_after = (
        sha256_file(
            database_path
        )
    )

    require(
        database_after
        == database_before,
        (
            f"{wave_token}: registry mutated "
            "during closure integration."
        ),
    )

    wave_results[
        wave_token
    ] = {
        "wave_id": (
            contract.wave_id
        ),
        "execution_contract_sha256": (
            actual_contract_sha
        ),
        "owner_authorization_sha256": (
            data[
                "auth"
            ]
        ),
        "preparation_index_sha256": (
            data[
                "prep"
            ]
        ),
        "registry_sha256": (
            database_after
        ),
        "authorized_case_count": 4,
        "accepted_case_count": 4,
        "certificate_sha256": (
            certificate_set
        ),
        "hard_gate_count_per_case": 13,
        "accepted_increment_count_per_case": 20,
        "rotational_moment_equilibrium_status": (
            "not_assessed"
        ),
        "closure_path": str(
            replay_path.relative_to(
                ROOT
            )
        ).replace(
            "\\",
            "/",
        ),
        "closure_sha256": (
            closure_sha
        ),
        "state_machine_phase": (
            decision.phase.value
        ),
        "registry_mutated": False,
    }


